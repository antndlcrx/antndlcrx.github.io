---
interface Props { benchmark: 'swe-bench' | 'livecodebench' | 'airs-bench' }
const { benchmark } = Astro.props;
const sources = {
  'swe-bench': { title: 'SWE-bench', owner: 'the SWE-bench team', url: 'https://www.swebench.com/', kind: 'frame', note: 'Read the benchmark subset, percentage resolved, agent configuration and resource constraints together. A leaderboard row describes a tested system.' },
  livecodebench: { title: 'LiveCodeBench', owner: 'the LiveCodeBench team', url: 'https://livecodebench.github.io/leaderboard.html', kind: 'frame', note: 'Use the source’s date ranges and settings to interpret a score. Fresh problems reduce some exposure risks; they do not establish that all evaluation data are unseen.' },
  'airs-bench': { title: 'AIRS-Bench', owner: 'the AIRS-Bench authors', url: 'https://github.com/facebookresearch/airs-bench#leaderboard', kind: 'table', note: 'This fetches the public repository’s leaderboard. Its rows and publication dates can differ from the 27 agent configurations compared in Tanya’s slides. “Avg. norm. score” is not a percentage of tasks solved.' },
};
const source = sources[benchmark];
---
<section class="benchmark-live" data-benchmark={benchmark} data-kind={source.kind} data-url={source.url} aria-label={`${source.title} current source view`}>
  <p class="benchmark-live__label">Current source view</p>
  <p class="benchmark-live__title">{source.title}</p>
  <p>{source.note}</p>
  <div class="benchmark-live__actions"><button type="button">Load {source.title} here</button><a href={source.url} target="_blank" rel="noopener noreferrer">Open official source ↗</a></div>
  <p class="benchmark-live__status" role="status">Loads on request from {source.owner}. External content may change independently of these notes.</p>
  {source.kind === 'table' && <p class="benchmark-live__scroll" hidden>Scroll horizontally for seeds and result dates →</p>}
  <div class="benchmark-live__content" role="region" aria-label={`${source.title} source results; scroll horizontally if needed`} tabindex="0" hidden></div>
  <noscript><p>Use the official source link to explore current results.</p></noscript>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.benchmark-live').forEach(root => {
    const button = root.querySelector<HTMLButtonElement>('button')!;
    const content = root.querySelector<HTMLElement>('.benchmark-live__content')!;
    const status = root.querySelector<HTMLElement>('[role="status"]')!;
    button.addEventListener('click', async () => {
      button.disabled = true;
      content.replaceChildren();
      status.textContent = 'Loading the official source…';
      try {
        if (root.dataset.kind === 'frame') {
          const frame = document.createElement('iframe');
          frame.title = `${root.dataset.benchmark} official live leaderboard`;
          frame.src = root.dataset.url!;
          frame.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups');
          frame.referrerPolicy = 'no-referrer';
          const timer = window.setTimeout(() => status.textContent = 'The source is taking longer to load. You can use the official source link above.', 20000);
          frame.addEventListener('load', () => { clearTimeout(timer); status.textContent = `Official source view opened at ${new Date().toLocaleTimeString()}. The source controls its data and update schedule. If the view is unavailable, use the source link above.`; });
          frame.addEventListener('error', () => { clearTimeout(timer); status.textContent = 'The embedded source could not load. Use the official source link above.'; });
          content.append(frame);
        } else {
          const response = await fetch('https://raw.githubusercontent.com/facebookresearch/airs-bench/main/README.md', { signal: AbortSignal.timeout(15000) });
          if (!response.ok) throw new Error('Source unavailable');
          const markdown = await response.text();
          const section = markdown.split(/^## Leaderboard\s*$/m)[1]?.split(/^## /m)[0];
          const lines = section?.split('\n').filter(line => line.trim().startsWith('|'));
          if (!lines || lines.length < 3) throw new Error('Source format changed');
          const cells = (line: string) => line.trim().replace(/^\||\|$/g, '').split('|').map(cell => cell.trim().replace(/\*\*/g, ''));
          const headers = cells(lines[0]);
          const rows = lines.slice(2).map(cells);
          if (headers.length !== 4 || !headers[0].includes('Agent') || !headers[1].includes('norm.') || rows.some(row => row.length !== 4 || !/^\d{4}-\d{2}-\d{2}$/.test(row[3]))) throw new Error('Source format changed');
          const table = document.createElement('table');
          const caption = document.createElement('caption'); caption.textContent = 'Public AIRS-Bench repository leaderboard · result dates supplied by the authors'; table.append(caption);
          const head = table.createTHead().insertRow();
          headers.forEach(label => { const th = document.createElement('th'); th.scope = 'col'; th.textContent = label; head.append(th); });
          const body = table.createTBody();
          rows.forEach(row => { const tr = body.insertRow(); row.forEach((value, i) => { const cell = document.createElement(i === 0 ? 'th' : 'td'); if (i === 0) cell.setAttribute('scope', 'row'); cell.textContent = value; tr.append(cell); }); });
          content.append(table);
          status.textContent = `${rows.length} source rows fetched at ${new Date().toLocaleString()}. Result publication dates are shown separately in the table.`;
        }
        content.hidden = false;
        const scrollHint = root.querySelector<HTMLElement>('.benchmark-live__scroll');
        if (scrollHint) scrollHint.hidden = false;
        button.textContent = 'Reload source view';
      } catch {
        content.hidden = true;
        const scrollHint = root.querySelector<HTMLElement>('.benchmark-live__scroll');
        if (scrollHint) scrollHint.hidden = true;
        status.textContent = 'The current source could not be loaded or its format has changed. Use the official source link above; no substitute results are shown.';
        button.textContent = 'Try loading again';
      } finally { button.disabled = false; }
    });
  });
</script>
<style>
  .benchmark-live { border: 1px solid var(--border); border-radius: 10px; padding: 24px; margin: 28px 0 36px; background: var(--bg-card); min-width: 0; }
  .benchmark-live__label { font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--text-sec); margin: 0 0 8px; }
  .benchmark-live__title { font-family: var(--font-heading); font-size: 22px; font-weight: 600; margin: 0 0 12px; }
  .benchmark-live > p:not(.benchmark-live__title):not(.benchmark-live__label) { font-size: 13px; }
  .benchmark-live__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  button { border: 1px solid var(--c-a); border-radius: 6px; background: var(--c-a); color: white; padding: 10px 14px; font: inherit; font-size: 12px; cursor: pointer; }
  button:disabled { opacity: .6; cursor: wait; }
  button:focus-visible { outline: 2px solid var(--c-a); outline-offset: 3px; }
  .benchmark-live__actions a { font-size: 12px; }
  .benchmark-live__status { color: var(--text-sec); margin: 14px 0 0; }
  .benchmark-live__content { margin-top: 20px; overflow-x: auto; }
  .benchmark-live__scroll { color: var(--text-sec); font: 10px var(--font-mono); margin: 16px 0 0; }
  .benchmark-live__scroll:not([hidden]) { display: none; }
  .benchmark-live__content:focus-visible { outline: 2px solid var(--c-a); outline-offset: 3px; }
  .benchmark-live__content :global(iframe) { border: 1px solid var(--border); width: 100%; height: 560px; background: white; }
  .benchmark-live__content :global(table) { min-width: 600px; width: 100%; font-size: 11px; border-collapse: collapse; }
  .benchmark-live__content :global(th), .benchmark-live__content :global(td) { text-align: left; padding: 10px; border-bottom: 1px solid var(--border); }
  .benchmark-live__content :global(caption) { text-align: left; color: var(--text-sec); padding-bottom: 12px; }
  @media (max-width: 700px) { .benchmark-live__scroll:not([hidden]) { display: block; } }
  @media (max-width: 500px) { .benchmark-live { padding: 18px; } .benchmark-live__content :global(iframe) { height: 480px; } }
</style>
